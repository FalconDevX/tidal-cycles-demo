setcps (350/60/4)

d1 $ cat
  [ note "g4 bf4 d5 g5" # s "nexus" # gain "1.4"
  , note "bf5 d5 g5 bf5" # s "nexus" # gain "1.4"
  , note "f4 a4 c5 f5" # s "nexus" # gain "1.4"
  , note "a5 c5 f5 a5" # s "nexus" # gain "1.4"
  , note "ef4 g4 c5 ef5" # s "nexus" # gain "1.4"
  , note "g5 c5 d5 g5" # s "nexus" # gain "1.4"
  , note "c4 ef4 g4 bf4" # s "nexus" # gain "1.4"
  , note "c5 c5 c5 c5" # s "nexus" # gain "1.4"
]

d2 $ cat
  [ note "g4 g4 g4 g4" # s "nexus2" # gain "1.3" # midichan 1
  , note "g4 g4 g4 g4" # s "nexus2" # gain "1.3" # midichan 1
  , note "f4 f4 f4 f4" # s "nexus2" # gain "1.3" # midichan 1
  , note "f4 f4 f4 f4" # s "nexus2" # gain "1.3" # midichan 1
  , note "ef4 ef4 ef4 ef4" # s "nexus2" # gain "1.3" # midichan 1
  , note "ef4 ef4 ef4 ef4" # s "nexus2" # gain "1.3" # midichan 1
  , note "c4 c4 c4 c4" # s "nexus2" # gain "1.3" # midichan 1
  , note "c4 c4 c4 c4" # s "nexus2" # gain "1.3" # midichan 1
  ]

d3 $ cat
    [
        stack [
            sound "bd ~ ~ ~" # gain "1.3",
            sound "~ ~ sd ~" # gain "1.3" # room 0 # size 0,
            sound "hh*4" # gain "1 0.6 0.8 0.6"
        ],
        stack [
            sound "bd ~ ~ ~" # gain "1.3",
            sound "~ ~ sd ~" # gain "1.3" # room 0 # size 0,
            sound "hh*4" # gain "1 0.6 0.8 0.6"
        ],
        stack [
            sound "bd ~ ~ ~" # gain "1.3",
            sound "~ ~ sd ~" # gain "1.3" # room 0 # size 0,
            sound "hh*4" # gain "1 0.6 0.8 0.6"
        ],
        stack [
            sound "bd ~ ~ ~" # gain "1.3",
            sound "~ ~ sd sd" # gain "1.3" # room 0 # size 0,
            sound "hh*4" # gain "1 0.6 0.8 0.6"
        ]
    ]

d4 $
  slow 2 $
  cat
    [
      note "d5 bf5" # s "nexus2" # midichan 2 # gain "1.3",
      silence,
      note "bf4 d5" # s "nexus2" # midichan 2 # gain "1.3",
      silence
    ]

d5 $
    slow 2 $
    cat
    [
        silence,
        note "g5 ~ g5 ~ g5 ~" # s "nexus" # midichan 2 # gain "1.3" ,
        silence,
        note "g4 ~ g4 ~ g4 ~" # s "nexus" # midichan 2 # gain "1.3"
    ]

d6 $
  slow 2 $
  cat
  [
    n "g'min" # s "nexus" # midichan 3 gain "1.3",
    n "f'maj" # s "nexus" # midichan 3 gain "1.3",
    n "ef'maj" # s "nexus" # midichan 3 gain "1.3",
    n "c'min" # s "nexus" # midichan 3 gain "1.3"
  ]

hush
